# Host dev (`bun run dev`) reads these five.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_DATABASE=cosplay-closet

# compose.yaml only. Alphanumeric: the app puts it into a mysql:// URL.
MYSQL_ROOT_PASSWORD=
# Host port for the app, on every interface. NPM forwards to <this host>:PORT.
PORT=3000

# Google Doc id of the "Cosplay Bin List" (the part between /d/ and /edit).
# The doc must be shared as "Anyone with the link can view". Used by the
# "Sync from Bin List" menu item; unset, the sync answers 400.
BIN_LIST_DOC_ID=
